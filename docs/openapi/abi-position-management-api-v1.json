{
  "openapi": "3.1.0",
  "info": {
    "title": "ABI Position Management API",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/strategy-instances/{strategy_instance_id}/trade-cycles/{trade_cycle_id}/protection": {
      "put": {
        "operationId": "applyPositionProtection",
        "summary": "Replace the protective stop/take state of an already-open, Runtime-owned trade cycle position",
        "parameters": [
          {
            "name": "strategy_instance_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          },
          {
            "name": "trade_cycle_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProtectionRequest" },
              "examples": {
                "withTake": {
                  "value": { "stop_price": "99000", "take_price": "103000" }
                },
                "stopOnly": {
                  "value": { "stop_price": "99000", "take_price": null }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The requested protection has been verified as the position's actual current protection",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProtectionAppliedResponse" },
                "examples": {
                  "applied": {
                    "value": {
                      "strategy_instance_id": "runtime-owned-instance-id",
                      "trade_cycle_id": "runtime-owned-cycle-id",
                      "status": "protection_applied",
                      "stop_price": "99000",
                      "take_price": "103000",
                      "protection_orders": {
                        "quantity": "0.010",
                        "stop": { "order_id": "native-stop-order-id", "trigger_price": "99000.0" },
                        "take": { "order_id": "native-take-order-id", "trigger_price": "103000.0" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing or malformed JSON",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MalformedJsonError" },
                "example": { "error": { "code": "malformed_json", "message": "request body must be valid JSON" } }
              }
            }
          },
          "415": {
            "description": "Unsupported media type",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UnsupportedMediaTypeError" },
                "example": {
                  "error": { "code": "unsupported_media_type", "message": "content-type must be application/json" }
                }
              }
            }
          },
          "422": {
            "description": "Transport validation failed, no correlation record exists for the pair, the resolved scope's exchange category is out of scope, the pair has no live position to protect, or the pair's scope currently has more than one active owner",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProtectionBusinessError" },
                "examples": {
                  "validation_failed": {
                    "value": {
                      "error": {
                        "code": "validation_failed",
                        "message": "request validation failed",
                        "details": [{ "path": "/stop_price", "message": "stop_price must be strictly positive exact-decimal text" }]
                      }
                    }
                  },
                  "unknown_trade_cycle_binding": {
                    "value": {
                      "error": {
                        "code": "unknown_trade_cycle_binding",
                        "message": "no correlation record exists for the requested pair"
                      }
                    }
                  },
                  "unsupported_exchange_scope": {
                    "value": {
                      "error": {
                        "code": "unsupported_exchange_scope",
                        "message": "resolved position's exchange category is not supported"
                      }
                    }
                  },
                  "position_not_open": {
                    "value": {
                      "error": {
                        "code": "position_not_open",
                        "message": "no live position exists for the requested pair"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Ambiguous ownership, or the write could not be safely verified",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InternalError" },
                "example": { "error": { "code": "internal_error", "message": "internal error" } }
              }
            }
          }
        }
      }
    },
    "/v1/strategy-instances/{strategy_instance_id}/trade-cycles/{trade_cycle_id}/close": {
      "post": {
        "operationId": "closeTradeCycle",
        "summary": "Close exposure_fraction of an already-open, Runtime-owned trade cycle's own resolved exposure",
        "description": "V1 accepts only exposure_fraction values numerically equal to 1 (the canonical value meaning the requested trade cycle's entire resolved exposure) — no caller-supplied absolute quantity is ever accepted; ABI resolves that itself. Replaces the retired empty-bodied DELETE .../open-position route, which no longer exists.",
        "parameters": [
          {
            "name": "strategy_instance_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          },
          {
            "name": "trade_cycle_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CloseRequest" },
              "examples": {
                "fullClose": {
                  "value": { "exposure_fraction": "1" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The requested cycle's own resolved exposure is verified closed and no order ABI attributes to the pair remains active",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TradeCycleClosedResponse" },
                "examples": {
                  "closed": {
                    "value": {
                      "strategy_instance_id": "runtime-owned-instance-id",
                      "trade_cycle_id": "runtime-owned-cycle-id",
                      "status": "trade_cycle_closed",
                      "closure": {
                        "strategy_instance_id": "runtime-owned-instance-id",
                        "trade_cycle_id": "runtime-owned-cycle-id",
                        "reason": "runtime_signal",
                        "order_id": "exchange-close-order-id",
                        "order_link_id": "abi-close-order-link-id",
                        "parent_order_link_id": null
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing or malformed JSON",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MalformedJsonError" },
                "example": { "error": { "code": "malformed_json", "message": "request body must be valid JSON" } }
              }
            }
          },
          "415": {
            "description": "Unsupported media type",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UnsupportedMediaTypeError" },
                "example": {
                  "error": { "code": "unsupported_media_type", "message": "content-type must be application/json" }
                }
              }
            }
          },
          "422": {
            "description": "Transport validation failed (including a non-canonical exposure_fraction), no correlation record exists for the pair, the resolved scope's exchange category is out of scope, or the requested cycle's own close order did not fully execute its resolved exposure",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CloseBusinessError" },
                "examples": {
                  "validation_failed": {
                    "value": {
                      "error": {
                        "code": "validation_failed",
                        "message": "request validation failed",
                        "details": [{ "path": "/exposure_fraction", "message": "exposure_fraction must be exact-decimal text numerically equal to \"1\"" }]
                      }
                    }
                  },
                  "unknown_trade_cycle_binding": {
                    "value": {
                      "error": {
                        "code": "unknown_trade_cycle_binding",
                        "message": "no correlation record exists for the requested pair"
                      }
                    }
                  },
                  "unsupported_exchange_scope": {
                    "value": {
                      "error": {
                        "code": "unsupported_exchange_scope",
                        "message": "resolved position's exchange category is not supported"
                      }
                    }
                  },
                  "close_execution_incomplete": {
                    "value": {
                      "error": {
                        "code": "close_execution_incomplete",
                        "message": "the requested cycle's own close order did not fully execute the resolved exposure"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Ambiguous ownership, incomplete or contradictory pair correlation, or the close could not be safely verified",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InternalError" },
                "example": { "error": { "code": "internal_error", "message": "internal error" } }
              }
            }
          }
        }
      }
    },
    "/v1/strategy-instances/{strategy_instance_id}/trade-cycles/{trade_cycle_id}/entry-remainder/cancel": {
      "post": {
        "operationId": "cancelEntryRemainder",
        "summary": "End the unfilled remainder of an already filled entry order of the trade cycle",
        "description": "Applies only after the cycle's entry order has a captured first fill. ABI finds the order through the pair's own correlation; the request carries no exchange identifier. A live remainder is cancelled and confirmed terminal; an already terminal order is left alone. The position and its protection are never touched.",
        "parameters": [
          {
            "name": "strategy_instance_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "trade_cycle_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntryRemainderCancelRequest"
              },
              "examples": {
                "empty": {
                  "value": {}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The entry order is confirmed terminal: its remainder was cancelled now, or it was already terminal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryRemainderCancelResponse"
                },
                "examples": {
                  "cancelled": {
                    "value": {
                      "strategy_instance_id": "runtime-owned-instance-id",
                      "trade_cycle_id": "runtime-owned-cycle-id",
                      "status": "entry_remainder_cancelled",
                      "executed_quantity": "0.004"
                    }
                  },
                  "alreadyTerminal": {
                    "value": {
                      "strategy_instance_id": "runtime-owned-instance-id",
                      "trade_cycle_id": "runtime-owned-cycle-id",
                      "status": "entry_order_already_terminal",
                      "executed_quantity": "0.01"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing or malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MalformedJsonError"
                },
                "example": {
                  "error": {
                    "code": "malformed_json",
                    "message": "request body must be valid JSON"
                  }
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnsupportedMediaTypeError"
                },
                "example": {
                  "error": {
                    "code": "unsupported_media_type",
                    "message": "content-type must be application/json"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Transport validation failed, no correlation record exists for the pair, or the pair's entry order has no captured fill",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntryRemainderCancelBusinessError"
                },
                "examples": {
                  "unknown_trade_cycle_binding": {
                    "value": {
                      "error": {
                        "code": "unknown_trade_cycle_binding",
                        "message": "no correlation record exists for the requested pair"
                      }
                    }
                  },
                  "entry_not_filled": {
                    "value": {
                      "error": {
                        "code": "entry_not_filled",
                        "message": "the requested pair's entry order has no captured fill"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Contradictory pair correlation, or the entry order could not be confirmed terminal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalError"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "internal error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProtectionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stop_price", "take_price"],
        "properties": {
          "stop_price": { "type": "string", "format": "positive-exact-decimal" },
          "take_price": {
            "oneOf": [{ "type": "string", "format": "positive-exact-decimal" }, { "type": "null" }]
          }
        }
      },
      "ProtectionAppliedResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["strategy_instance_id", "trade_cycle_id", "status", "stop_price", "take_price", "protection_orders"],
        "properties": {
          "strategy_instance_id": { "type": "string", "minLength": 1 },
          "trade_cycle_id": { "type": "string", "minLength": 1 },
          "status": { "const": "protection_applied" },
          "stop_price": { "type": "string", "format": "positive-exact-decimal" },
          "take_price": {
            "oneOf": [{ "type": "string", "format": "positive-exact-decimal" }, { "type": "null" }]
          },
          "protection_orders": { "$ref": "#/components/schemas/ProtectionOrders" }
        }
      },
      "ProtectionOrders": {
        "type": "object",
        "description": "The attributed native protective orders of the exchange read that proved this success (the post-amend read-back, or the matching initial read when no write was sent). Values are the exchange's own strings, unchanged. take is always present: when take_price is null it is the dormant surrogate take order.",
        "additionalProperties": false,
        "required": ["quantity", "stop", "take"],
        "properties": {
          "quantity": {
            "type": "string",
            "format": "positive-exact-decimal",
            "description": "The position quantity both protective orders carry (the exchange order quantity, equal on both legs): the cycle's current own filled quantity."
          },
          "stop": { "$ref": "#/components/schemas/ProtectionOrder" },
          "take": { "$ref": "#/components/schemas/ProtectionOrder" }
        }
      },
      "ProtectionOrder": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order_id", "trigger_price"],
        "properties": {
          "order_id": { "type": "string", "minLength": 1, "description": "The exchange order id" },
          "trigger_price": { "type": "string", "format": "positive-exact-decimal", "description": "The exchange trigger price" }
        }
      },
      "CloseRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exposure_fraction"],
        "properties": {
          "exposure_fraction": {
            "type": "string",
            "description": "V1 accepts only exact-decimal text numerically equal to 1 (the requested cycle's entire resolved exposure). Reserved for a future fractional value; no partial-close behavior exists in V1."
          }
        }
      },
      "TradeCycleClosedResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["strategy_instance_id", "trade_cycle_id", "status", "closure"],
        "properties": {
          "strategy_instance_id": { "type": "string", "minLength": 1 },
          "trade_cycle_id": { "type": "string", "minLength": 1 },
          "status": { "const": "trade_cycle_closed" },
          "closure": {
            "description": "The proven completion: ABI's own close order, or this cycle's own protection when it executed before or during the close. null when the cycle held no own exposure or its completion carries no own order.",
            "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/TradeCycleClosure" }]
          }
        }
      },
      "TradeCycleClosure": {
        "description": "Proven completion of this trade cycle by full execution of an order ABI attributes to this exact pair. Execution price and time are not part of V1.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/TradeCycleClosureRuntimeSignal"
          },
          {
            "$ref": "#/components/schemas/TradeCycleClosureProtection"
          }
        ]
      },
      "TradeCycleClosureRuntimeSignal": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "strategy_instance_id",
          "trade_cycle_id",
          "reason",
          "order_id",
          "order_link_id",
          "parent_order_link_id"
        ],
        "properties": {
          "strategy_instance_id": {
            "type": "string",
            "minLength": 1
          },
          "trade_cycle_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "const": "runtime_signal"
          },
          "order_id": {
            "type": "string",
            "minLength": 1,
            "description": "Exchange order id of ABI's own close order"
          },
          "order_link_id": {
            "type": "string",
            "minLength": 1,
            "description": "Client identifier of ABI's own close order"
          },
          "parent_order_link_id": {
            "type": "null"
          }
        }
      },
      "TradeCycleClosureProtection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "strategy_instance_id",
          "trade_cycle_id",
          "reason",
          "order_id",
          "order_link_id",
          "parent_order_link_id"
        ],
        "properties": {
          "strategy_instance_id": {
            "type": "string",
            "minLength": 1
          },
          "trade_cycle_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "oneOf": [
              {
                "const": "stop_loss"
              },
              {
                "const": "take_profit"
              }
            ]
          },
          "order_id": {
            "type": "string",
            "minLength": 1,
            "description": "Exchange order id of the executed protection order"
          },
          "order_link_id": {
            "type": "null"
          },
          "parent_order_link_id": {
            "type": "string",
            "minLength": 1,
            "description": "Client identifier of this cycle's own entry order"
          }
        }
      },
      "ValidationDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "message"],
        "properties": {
          "path": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "MalformedJsonError": { "$ref": "#/components/schemas/MalformedJsonErrorEnvelope" },
      "MalformedJsonErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "const": "malformed_json" },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "UnsupportedMediaTypeError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "const": "unsupported_media_type" },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "ValidationFailedError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "details"],
            "properties": {
              "code": { "const": "validation_failed" },
              "message": { "type": "string", "minLength": 1 },
              "details": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/components/schemas/ValidationDetail" }
              }
            }
          }
        }
      },
      "UnknownTradeCycleBindingError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "const": "unknown_trade_cycle_binding" },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "UnsupportedExchangeScopeError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "const": "unsupported_exchange_scope" },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "PositionNotOpenError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "const": "position_not_open" },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "CloseExecutionIncompleteError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "const": "close_execution_incomplete" },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "ProtectionBusinessError": {
        "oneOf": [
          { "$ref": "#/components/schemas/ValidationFailedError" },
          { "$ref": "#/components/schemas/UnknownTradeCycleBindingError" },
          { "$ref": "#/components/schemas/UnsupportedExchangeScopeError" },
          { "$ref": "#/components/schemas/PositionNotOpenError" }
        ]
      },
      "CloseBusinessError": {
        "oneOf": [
          { "$ref": "#/components/schemas/ValidationFailedError" },
          { "$ref": "#/components/schemas/UnknownTradeCycleBindingError" },
          { "$ref": "#/components/schemas/UnsupportedExchangeScopeError" },
          { "$ref": "#/components/schemas/CloseExecutionIncompleteError" }
        ]
      },
      "InternalError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "const": "internal_error" },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "EntryRemainderCancelRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "description": "Always the empty object."
      },
      "EntryRemainderCancelResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "strategy_instance_id",
          "trade_cycle_id",
          "status",
          "executed_quantity"
        ],
        "properties": {
          "strategy_instance_id": {
            "type": "string",
            "minLength": 1
          },
          "trade_cycle_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "entry_remainder_cancelled",
              "entry_order_already_terminal"
            ]
          },
          "executed_quantity": {
            "description": "Exact-decimal text of the entry order's confirmed executed quantity; null when the cycle is already closed or the terminal order is no longer returned at all.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "positive-exact-decimal"
              }
            ]
          }
        }
      },
      "EntryNotFilledError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "const": "entry_not_filled"
              },
              "message": {
                "type": "string",
                "minLength": 1
