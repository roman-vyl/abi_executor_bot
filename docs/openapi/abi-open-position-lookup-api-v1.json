{
  "openapi": "3.1.0",
  "info": {
    "title": "ABI Open Position Lookup API",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/strategy-instances/{strategy_instance_id}/trade-cycles/{trade_cycle_id}/open-position": {
      "get": {
        "operationId": "getOpenPositionForTradeCycle",
        "summary": "Read the current, live-truth open-position state of one Runtime-owned trade cycle",
        "description": "Returns whether a live position currently exists on the exchange for the given (strategy_instance_id, trade_cycle_id) pair. V1 operating precondition: for the API credentials configured for a given ABI deployment, no manual or other-strategy-owned exposure may exist concurrently on the same exchange symbol a resolved record uses. This endpoint's symbol and side check is a plausibility check against the resolved record's own declared intent, not proof that the reported exposure was caused specifically by this record's own order.",
        "parameters": [
          {
            "name": "strategy_instance_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "trade_cycle_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The current open-position state was resolved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenPositionResponse"
                },
                "examples": {
                  "open": {
                    "value": {
                      "position_open": true,
                      "first_fill_at_ms": 1785000012345,
                      "average_entry_price": "100000"
                    }
                  },
                  "closed": {
                    "value": {
                      "position_open": false,
                      "first_fill_at_ms": null,
                      "average_entry_price": null
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Transport validation failed, no correlation record exists for the pair, or the record's exchange category is out of scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenPositionBusinessError"
                },
                "examples": {
                  "validation_failed": {
                    "value": {
                      "error": {
                        "code": "validation_failed",
                        "message": "request validation failed",
                        "details": [
                          {
                            "path": "/path/trade_cycle_id",
                            "message": "path value must be a non-empty string"
                          }
                        ]
                      }
                    }
                  },
                  "unknown_trade_cycle_binding": {
                    "value": {
                      "error": {
                        "code": "unknown_trade_cycle_binding",
                        "message": "no correlation record exists for the requested pair"
                      }
                    }
                  },
                  "unsupported_exchange_scope": {
                    "value": {
                      "error": {
                        "code": "unsupported_exchange_scope",
                        "message": "record's exchange category is not supported"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The record's state could not be safely resolved, or the live exchange query failed, was malformed, or was ambiguous",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalError"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "internal error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OpenPositionResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/OpenPositionOpenResponse"
          },
          {
            "$ref": "#/components/schemas/OpenPositionClosedResponse"
          }
        ]
      },
      "OpenPositionOpenResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position_open",
          "first_fill_at_ms",
          "average_entry_price"
        ],
        "properties": {
          "position_open": {
            "const": true
          },
          "first_fill_at_ms": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "average_entry_price": {
            "type": "string",
            "format": "positive-exact-decimal"
          }
        }
      },
      "OpenPositionClosedResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position_open",
          "first_fill_at_ms",
          "average_entry_price"
        ],
        "properties": {
          "position_open": {
            "const": false
          },
          "first_fill_at_ms": {
            "type": "null"
          },
          "average_entry_price": {
            "type": "null"
          }
        }
      },
      "ValidationDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "message"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "OpenPositionBusinessError": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ValidationFailedError"
          },
          {
            "$ref": "#/components/schemas/UnknownTradeCycleBindingError"
          },
          {
            "$ref": "#/components/schemas/UnsupportedExchangeScopeError"
          }
        ]
      },
      "ValidationFailedError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "details"
            ],
            "properties": {
              "code": {
                "const": "validation_failed"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/components/schemas/ValidationDetail"
                }
              }
            }
          }
        }
      },
      "UnknownTradeCycleBindingError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "const": "unknown_trade_cycle_binding"
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "UnsupportedExchangeScopeError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "const": "unsupported_exchange_scope"
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "InternalError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "const": "internal_error"
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
